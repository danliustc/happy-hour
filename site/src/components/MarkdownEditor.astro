---
interface Props {
  initialTitle?: string;
  initialBody?: string;
  initialTags?: string[];
  articleId?: number;
}

const { initialTitle = '', initialBody = '', initialTags = [], articleId } = Astro.props;
---

<div class="editor-wrap">
  <div class="editor-header">
    <input type="text" id="article-title" placeholder="Article title..." value={initialTitle} class="title-input" />
  </div>

  <div id="vditor" data-initial={initialBody}></div>

  <div class="editor-footer">
    <div class="tag-row">
      <div class="tag-input-wrap">
        <input type="text" id="tag-input" placeholder="Add tags (comma separated)" class="tag-field" />
        <div id="tag-suggestions" class="tag-suggestions hidden"></div>
      </div>
      <button id="ai-tags-btn" class="ai-btn" type="button" title="Generate tags with AI">
        ✦ AI 生成标签
      </button>
    </div>
    <div id="tag-list" class="tag-list">
      {initialTags.map(tag => (
        <span class="tag-pill" data-tag={tag}>
          {tag}
          <button class="tag-remove" type="button">&times;</button>
        </span>
      ))}
    </div>
    <button id="publish-btn" class="publish-btn" data-article-id={articleId || ''}>
      {articleId ? 'Update' : 'Publish'}
    </button>
  </div>
</div>

<script>
  import Vditor from 'vditor';
  import 'vditor/dist/index.css';

  const container = document.getElementById('vditor')!;
  const initialBody = container.dataset.initial || '';
  const titleInput = document.getElementById('article-title') as HTMLInputElement;
  const tagInput = document.getElementById('tag-input') as HTMLInputElement;
  const tagSuggestions = document.getElementById('tag-suggestions')!;
  const tagList = document.getElementById('tag-list')!;
  const publishBtn = document.getElementById('publish-btn')!;
  const aiTagsBtn = document.getElementById('ai-tags-btn') as HTMLButtonElement;

  let vditor: Vditor;

  vditor = new Vditor('vditor', {
    mode: 'ir',
    theme: 'dark',
    value: initialBody,
    minHeight: 480,
    toolbar: [
      'bold', 'italic', 'strike', '|',
      'headings', '|',
      'code', 'inline-code', 'quote', '|',
      'list', 'ordered-list', 'check', '|',
      'link', 'table', 'upload', '|',
      'undo', 'redo', '|',
      'fullscreen',
    ],
    upload: {
      handler: async (files: File[]) => {
        const file = files[0];
        if (!file) return null;
        const formData = new FormData();
        formData.append('file', file);
        try {
          const res = await fetch('/api/upload', { method: 'POST', body: formData });
          const data = await res.json() as { url?: string; error?: string };
          if (!res.ok) return data.error || 'Upload failed';
          const name = file.name.replace(/\.[^.]+$/, '');
          vditor.insertValue(`![${name}](${data.url!})\n`);
        } catch {
          return 'Upload failed';
        }
        return null;
      },
    },
    preview: {
      theme: { current: 'dark' },
      hljs: { style: 'github-dark' },
    },
    cache: { enable: false },
  });

  // Tag management
  function getTags(): string[] {
    return Array.from(tagList.querySelectorAll('.tag-pill')).map(
      el => (el as HTMLElement).dataset.tag!
    );
  }

  function addTag(name: string) {
    const trimmed = name.trim().toLowerCase();
    if (!trimmed || getTags().includes(trimmed)) return;
    const pill = document.createElement('span');
    pill.className = 'tag-pill';
    pill.dataset.tag = trimmed;
    pill.innerHTML = `${trimmed}<button class="tag-remove" type="button">&times;</button>`;
    pill.querySelector('.tag-remove')!.addEventListener('click', () => pill.remove());
    tagList.appendChild(pill);
  }

  tagList.querySelectorAll('.tag-remove').forEach(btn => {
    btn.addEventListener('click', () => (btn as HTMLElement).closest('.tag-pill')?.remove());
  });

  tagInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ',') {
      e.preventDefault();
      const val = tagInput.value.replace(/,/g, '').trim();
      if (val) addTag(val);
      tagInput.value = '';
      tagSuggestions.classList.add('hidden');
    }
  });

  let debounceTimer: number;
  tagInput.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    const q = tagInput.value.trim();
    if (q.length < 1) {
      tagSuggestions.classList.add('hidden');
      return;
    }
    debounceTimer = window.setTimeout(async () => {
      const res = await fetch(`/api/tags/suggest?q=${encodeURIComponent(q)}`);
      const tags = await res.json() as { name: string }[];
      if (tags.length === 0) {
        tagSuggestions.classList.add('hidden');
        return;
      }
      tagSuggestions.innerHTML = tags.map(t =>
        `<button class="suggestion" type="button">${t.name}</button>`
      ).join('');
      tagSuggestions.classList.remove('hidden');
      tagSuggestions.querySelectorAll('.suggestion').forEach(btn => {
        btn.addEventListener('click', () => {
          addTag(btn.textContent!);
          tagInput.value = '';
          tagSuggestions.classList.add('hidden');
        });
      });
    }, 200);
  });

  // AI tag generation
  aiTagsBtn.addEventListener('click', async () => {
    const title = titleInput.value.trim();
    const content = vditor.getValue().trim();
    if (!title && !content) {
      alert('Please write some content first');
      return;
    }
    aiTagsBtn.disabled = true;
    aiTagsBtn.textContent = 'Generating...';
    try {
      const res = await fetch('/api/ai/generate-tags', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, content }),
      });
      const data = await res.json() as { tags?: string[]; error?: string };
      if (!res.ok || !data.tags) {
        alert(data.error || 'Failed to generate tags');
        return;
      }
      for (const tag of data.tags) addTag(tag);
    } catch {
      alert('Failed to generate tags');
    } finally {
      aiTagsBtn.disabled = false;
      aiTagsBtn.textContent = '✦ AI 生成标签';
    }
  });

  // Publish
  publishBtn.addEventListener('click', async () => {
    const title = titleInput.value.trim();
    const body = vditor.getValue().trim();
    const tags = getTags();
    const articleId = (publishBtn as HTMLElement).dataset.articleId;

    if (!title || !body) {
      alert('Title and body are required');
      return;
    }

    publishBtn.setAttribute('disabled', 'true');
    publishBtn.textContent = 'Publishing...';

    try {
      const url = articleId ? `/api/articles/${articleId}` : '/api/articles';
      const method = articleId ? 'PUT' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, body_markdown: body, tags }),
      });
      const data = await res.json() as { id: number; slug: string; error?: string };
      if (!res.ok) {
        alert(data.error || 'Failed to publish');
        return;
      }
      const userMeta = document.querySelector('meta[name="current-user"]');
      const username = userMeta?.getAttribute('content') || '';
      window.location.href = `/${username}/${data.slug}/`;
    } catch {
      alert('Failed to publish');
    } finally {
      publishBtn.removeAttribute('disabled');
      publishBtn.textContent = articleId ? 'Update' : 'Publish';
    }
  });
</script>

<style>
  .editor-wrap {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .title-input {
    width: 100%;
    padding: 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 600;
    outline: none;
  }

  .title-input:focus {
    border-color: var(--accent-dim);
  }

  /* Vditor theme overrides to match site */
  :global(#vditor) {
    border-radius: 8px;
    border-color: var(--border) !important;
  }

  :global(.vditor--dark) {
    --panel-background-color: var(--bg-card) !important;
    --textarea-background-color: var(--bg-card) !important;
  }

  :global(.vditor-toolbar) {
    background: var(--bg) !important;
    border-bottom-color: var(--border) !important;
    border-radius: 8px 8px 0 0 !important;
  }

  :global(.vditor-content) {
    background: var(--bg-card) !important;
    border-radius: 0 0 8px 8px !important;
  }

  :global(.vditor-ir) {
    font-family: var(--font-mono) !important;
    font-size: 0.9rem !important;
    line-height: 1.8 !important;
  }

  .hidden {
    display: none;
  }

  .editor-footer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .tag-row {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .tag-row .tag-input-wrap {
    flex: 1;
  }

  .ai-btn {
    flex-shrink: 0;
    padding: 0.5rem 0.9rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.2s, background 0.2s;
  }

  .ai-btn:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .ai-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .tag-input-wrap {
    position: relative;
  }

  .tag-field {
    width: 100%;
    padding: 0.5rem 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    outline: none;
  }

  .tag-field:focus {
    border-color: var(--accent-dim);
  }

  .tag-suggestions {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-top: 0.25rem;
    z-index: 10;
    overflow: hidden;
  }

  .suggestion {
    display: block;
    width: 100%;
    padding: 0.5rem 0.75rem;
    background: none;
    border: none;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-align: left;
    cursor: pointer;
  }

  .suggestion:hover {
    background: var(--bg);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.6rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }

  .tag-remove {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 1rem;
    padding: 0;
    line-height: 1;
  }

  .publish-btn {
    align-self: flex-end;
    padding: 0.6rem 1.5rem;
    background: var(--accent);
    color: var(--bg);
    border: none;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .publish-btn:hover {
    opacity: 0.9;
  }

  .publish-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
