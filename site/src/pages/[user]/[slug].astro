---
import NoteLayout from '../../layouts/NoteLayout.astro';
import Recommendations from '../../components/Recommendations.astro';
import Comments from '../../components/Comments.astro';
import { getDB, getArticleWithTags, getRecommendedArticles, getCommentsForArticle } from '../../lib/db';
import { renderMarkdown } from '../../lib/markdown';

const { user: username, slug } = Astro.params;
const db = getDB(Astro.locals);

const article = await getArticleWithTags(db, username!, slug!);
if (!article) {
  return new Response('Article not found', { status: 404 });
}

const tagIds = article.tags.map(t => t.id);
const [recommended, comments] = await Promise.all([
  tagIds.length > 0 ? getRecommendedArticles(db, article.id, tagIds, 5) : Promise.resolve([]),
  getCommentsForArticle(db, article.id),
]);

const renderedHtml = renderMarkdown(article.body_markdown);
---

<NoteLayout title={article.title} author={article.author_username} date={article.published_at} tags={article.tags}>
  <Fragment set:html={renderedHtml} />

  {recommended.length > 0 && (
    <Recommendations articles={recommended} />
  )}

  <Comments
    comments={comments}
    articleId={article.id}
    articleOwnerId={article.user_id}
    currentUser={Astro.locals.user ?? null}
  />
</NoteLayout>
